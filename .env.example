# Alpha Vantage API key (required) — get one at https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=your_api_key_here
ALPHA_VANTAGE_API_SECRET=your_api_secret_here

# Flask debug mode (optional, defaults to false)
FLASK_DEBUG=false

# Port (optional, defaults to 5000; set by Render/Railway automatically)
PORT=5000
